# ── Backend Environment Variables ──
# Copy this file to .env and fill in values

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./its_sql.db

# Google OAuth
GOOGLE_CLIENT_ID=auto-detected-from-firebase

# CORS (frontend URL)
FRONTEND_URL=http://localhost:5173

# Grading Sandbox
SANDBOX_DB_TYPE=sqlite
# If using MySQL sandbox:
# SANDBOX_DB_TYPE=mysql
# SANDBOX_MYSQL_HOST=localhost
# SANDBOX_MYSQL_PORT=3306
# SANDBOX_MYSQL_USER=root
# SANDBOX_MYSQL_PASSWORD=

# Allowed email domain
ALLOWED_EMAIL_DOMAIN=kmitl.ac.th

# ── LDAP / Active Directory (LDAPS) ──
LDAP_ENABLED=true
LDAP_HOST=your-ad-server.example.ac.th
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_TLS_VALIDATE=CERT_REQUIRED       # CERT_REQUIRED | CERT_OPTIONAL | CERT_NONE (dev)
LDAP_CA_CERTS_FILE=                    # optional path to the AD server's CA bundle
LDAP_BIND_USER=svc_bind@example.ac.th
LDAP_BIND_PASSWORD=change-me           # service account password (never commit real value)
LDAP_BASE_DN=DC=example,DC=ac,DC=th
LDAP_RATE_LIMIT=5
LDAP_RATE_WINDOW=60
