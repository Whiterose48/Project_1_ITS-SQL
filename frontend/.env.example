# ── ITS-SQL Frontend Environment Variables ──
# Copy this file to .env and fill in the values

# Backend API URL (change for production deployment)
# Netlify: Set this in Netlify Dashboard → Site Settings → Environment Variables
# Examples:
#   Local:      http://localhost:8000/api
#   Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# Google OAuth Client ID (optional — auto-detected from Firebase config if blank)
# If auto-detection fails on deployed domains, set this explicitly:
# Get it from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# GitHub Pages base path (only needed for GitHub Pages deployment)
# Set to '/repository-name/' for project pages, or '/' for user pages
# Example: VITE_BASE_PATH=/Project_1_ITS-SQL/
# VITE_BASE_PATH=/
